# Static records for zones hosted in the shared services account.
# Entries go in shared-records.auto.tfvars, which CI applies.
# Every domain here must also be in shared-domains.auto.tfvars.
# A domain with MX or SPF records must also be in mail_domains, or its records clash
# with the no-mail records published for it.

mail_domains = ["example.com"]

domain_records = {
  "example.com" = [
    {
      name    = "_dmarc"
      type    = "TXT"
      records = ["v=DMARC1; p=none"]
    },
    {
      name  = "www"
      type  = "A"
      alias = { name = "d111111abcdef8.cloudfront.net", zone_id = "Z2FDTNDATAQYW2" }
    },
    {
      name    = "@"
      type    = "MX"
      ttl     = 3600
      records = ["10 mail.example.com"]
    },
  ]
}
